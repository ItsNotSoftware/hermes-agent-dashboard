[Unit]
Description=Hermes Agent Dashboard (Go GUI)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
WorkingDirectory=%h/Repos/hermes-agent-dashboard
ExecStart=%h/Repos/hermes-agent-dashboard/dashboard
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
